# Data & caches - never commit. `data/raw` is ~26 MB of ingested parquet and
# `data/processed` ~25 MB of derived tables; both rebuild from the pipeline.
data/
cache/
fastf1_cache/
*.feather
*.ff1pkl

# ...except the fitted artefacts the deployed app reads (~100 KB total).
!models_out/
!models_out/**

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Model artefacts. These are regenerable with `python -m pitwall.pipeline`,
# but the small ones are committed so a clone can run the app -- and so the
# Docker build does not depend on a gitignored directory.
*.joblib
*.pkl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
*.key


# Intermediate outputs of a sharded audit run; merged into audit.parquet.
models_out/audit_shard*.parquet
models_out/audit_partial*.parquet
