	column 'Delta to Race Median (s)'
		dataType: double
		formatString: 0.000
		lineageTag: e43bea46-8e52-5145-a3ff-5af76290599b
		summarizeBy: none
		sourceColumn: delta_to_race_median_s

		annotation SummarizationSetBy = User

	partition Lap = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(PitWallFile("fact_lap.parquet"))),
				    Typed = Table.TransformColumnTypes(Source, {{"race_id", type text}, {"driver_code", type text}, {"team", type text}, {"lap", Int64.Type}, {"lap_time_s", type number}, {"compound", type text}, {"compound_rank", type text}, {"tyre_age_laps", type number}, {"stint", type number}, {"position", type number}, {"green_flag", type logical}, {"pit_in_lap", type logical}, {"pit_out_lap", type logical}, {"pace_lap", type logical}, {"delta_to_race_median_s", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
