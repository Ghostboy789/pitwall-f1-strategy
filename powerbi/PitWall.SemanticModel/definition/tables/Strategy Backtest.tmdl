	partition 'Strategy Backtest' = m
		mode: import
		source =
				let
				    Source = Csv.Document(PitWallFile("strategy_backtest.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"strategy_cost", type text}, {"source", type text}, {"estimate_s", type number}, {"ci_lo_s", type number}, {"ci_hi_s", type number}, {"races", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
