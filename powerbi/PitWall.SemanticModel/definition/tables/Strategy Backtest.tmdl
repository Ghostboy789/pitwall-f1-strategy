/// V6: the same cars costed from real finishing times and from simulated replays.
table 'Strategy Backtest'
	lineageTag: ba526c4d-342d-5dc5-b840-fae8bcf3a851

	column 'Strategy Cost'
		dataType: string
		lineageTag: bebf636a-4122-5e53-80b2-9fd10968cde1
		summarizeBy: none
		sourceColumn: strategy_cost

		annotation SummarizationSetBy = User

	column Source
		dataType: string
		lineageTag: 93558a8d-072f-5ed7-b4eb-29630568f2b9
		summarizeBy: none
		sourceColumn: source

