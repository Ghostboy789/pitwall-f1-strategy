{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "cost_bar",
  "position": {
    "x": 24,
    "y": 216,
    "z": 1300,
    "height": 226,
    "width": 1232,
    "tabOrder": 1300
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Circuit"
                    }
                  },
                  "Property": "Short Name"
                }
              },
              "queryRef": "Circuit.Short Name",
              "nativeQueryRef": "Short Name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Cost of Being Stuck (s)"
                }
              },
              "queryRef": "Key Measures.Cost of Being Stuck (s)",
              "nativeQueryRef": "Cost of Being Stuck (s)",
              "displayName": "Seconds lost"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Key Measures"
                  }
                },
                "Property": "Cost of Being Stuck (s)"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Seconds lost stuck behind a slower car, every circuit'"
                }
              }
            },
            "fontFamily": {
              "expr": {
                "Literal": {
                  "Value": "'''Segoe UI Semibold'', wf_segoe-ui_semibold, helvetica, arial, sans-serif'"
