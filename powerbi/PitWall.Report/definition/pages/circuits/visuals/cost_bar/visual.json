              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11.0D"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Follower 0.5 s/lap faster, 1 s behind in DRS range, 25 laps left. Red: estimate at its ceiling, so a floor.'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9.0D"
